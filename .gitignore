# -----------------------------------------------------------------------------
# OS / shell
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# Editor swap / lock files
.*.swp
.*.swo
*.swn
.vs/
.idea/
*.code-workspace

# CMake user overrides
CMakeUserPresets.json

# -----------------------------------------------------------------------------
# Agent / local tooling (per-AGENTS.md / umbrella .gitignore)
# -----------------------------------------------------------------------------
.omo/
.claude/

# -----------------------------------------------------------------------------
# ESP-IDF (C++ firmware; see firmware/partitions.csv, sdkconfig.defaults)
# -----------------------------------------------------------------------------
# Generated by `idf.py`; flash artifacts (inkwash.bin / .elf / .map,
# bootloader/, partition_table/, flash_args) live under build/.
/build/
/firmware/build/
# CMake metadata produced by ESP-IDF builds
/firmware/compile_commands.json

# ESP-IDF component manager: do not commit fetched components or lock.
managed_components/
dependencies.lock
dependencies.lock.*
/firmware/managed_components/
/firmware/dependencies.lock

# Per-target config (sdkconfig.defaults is the tracked source of truth)
sdkconfig
sdkconfig.old
/firmware/sdkconfig
/firmware/sdkconfig.old

# -----------------------------------------------------------------------------
# Python tooling (scripts/checks/*.py, scripts/device/*.py, scripts/assets/)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
.eggs/
.installed.cfg
MANIFEST

# Virtualenvs
.venv/
venv/
env/
ENV/

# Test / type / lint caches
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Device flashing, captures, smoke tests (scripts/device/, scripts/checks/)
# -----------------------------------------------------------------------------
# Note 4 full flash backups (16 MB each) belong outside git; restore only from
# the backup taken on the authorized board. Pattern intentionally narrow.
backups/*.bin

# Serial captures / smoke-test logs and local test artifacts
logs/
*.log
*.serial
tmp/
test-results/

# -----------------------------------------------------------------------------
# Generated CJK font blobs (regenerated by scripts/assets/generate_cjk_font.py)
# -----------------------------------------------------------------------------
# Tracked binaries live under firmware/assets/ (hzk16/hzk12/cjk_index) as
# release artifacts; ignore any accidental out-of-tree renders.
/firmware/assets/*.bak

# -----------------------------------------------------------------------------
# VS Code - keep tracked C++ project settings, drop machine-local state
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
